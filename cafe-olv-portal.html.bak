<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, height=device-height, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Cafe OLV Portal - Activity Feed</title>

    <link rel="stylesheet" href="style/olv_portal.css">
    <link rel="stylesheet" href="style/olv_sections.css">
    <link rel="stylesheet" href="style/olv_beta_menu.css">
    <link rel="stylesheet" href="style/olv_beta_2012.css">
    <link rel="stylesheet" href="style/olv_plaza_concept.css?v=plaza-touch-2">
</head>
<body>

<div id="wut-portal-stage">
    <menu id="global-menu" aria-label="Cafe OLV Portal">
        <li id="global-menu-mymenu" data-wut-menu-index="0">
            <a href="#user-page" data-wut-view="user-page" data-sound="SE_WAVE_MENU">
                <span class="mii-icon">
                    <img
                        id="wut-global-menu-mii"
                        src="res/olv/mii/img_unknown_MiiIcon.png"
                        alt="User Page"
                    >
                </span>
                <span>My Menu</span>
            </a>
        </li>

        <li id="global-menu-feed" class="selected wut-focused" data-wut-menu-index="1">
            <a href="#activity-feed" data-wut-view="activity-feed" data-sound="SE_WAVE_MENU">Activity Feed</a>
        </li>

        <li id="global-menu-community" data-wut-menu-index="2">
            <a href="#communities" data-wut-view="communities" data-sound="SE_WAVE_MENU">Plaza</a>
        </li>

        <li id="global-menu-message" data-wut-menu-index="3">
            <a href="#messages" data-wut-view="messages" data-sound="SE_WAVE_MENU">Message</a>
        </li>

        <li id="global-menu-news" data-wut-menu-index="4">
            <a href="#notifications" data-wut-view="notifications" data-sound="SE_WAVE_MENU">News</a>
        </li>

        <li id="global-menu-exit" data-wut-menu-index="5">
            <a href="#close" role="button" data-wut-action="close" data-sound="SE_WAVE_EXIT">Close</a>
        </li>
    </menu>

    <div id="body">
        <header id="header">
            <h1 id="page-title">Activity Feed</h1>
        </header>

        <div id="wut-portal-view" class="body-content" data-wut-current-view="activity-feed">
            <section
                id="wut-activity-feed-view"
                class="wut-portal-panel"
                aria-hidden="false"
            >
                <div class="wut-section-demo-strip">
                    <strong>CAFE OLV // ACTIVITY STREAM</strong>
                    <small>LOCAL PREVIEW CHANNEL 01</small>
                    <span><b>03</b> POSTS</span>
                </div>

                <div class="wut-section-scroll wut-feed-scroll">
                    <ul id="wut-feed-list" class="wut-feed-list">
                        <li>
                            <a href="#feed-wut-welcome" data-wut-focus-item="1" data-wut-demo-action="feed-post" data-wut-label="WUT Announcements post">
                                <span class="wut-post-user-icon">
                                    <img id="wut-feed-current-mii" src="res/olv/mii/img_unknown_MiiIcon.png" onerror="this.onerror=null;this.src='res/olv/mii/img_unknown_MiiIcon.png';" alt="Cafe User">
                                </span>
                                <span class="wut-post-body">
                                    <span class="wut-post-head">
                                        <strong id="wut-feed-user-name">Cafe User</strong>
                                        <small id="wut-feed-user-id">WUT_USER</small>
                                        <em>Just now</em>
                                    </span>
                                    <span class="wut-post-community">
                                        <img src="res/olv/default-image.png" alt="">
                                        WUT Announcements
                                    </span>
                                    <span class="wut-post-copy">The Cafe OLV Portal is online. This local feed is ready for the WUT post service.</span>
                                    <span class="wut-post-meta">
                                        <b class="wut-yeah-control">Yeah!</b>
                                        <span>2 Yeahs</span>
                                        <span>1 Comment</span>
                                        <i>DEMO DATA</i>
                                    </span>
                                </span>
                            </a>
                        </li>

                        <li>
                            <a href="#feed-community-preview" data-wut-focus-item="1" data-wut-demo-action="feed-post" data-wut-label="Community preview post">
                                <span class="wut-post-user-icon">
                                    <img src="res/olv/mii/img_unknown_MiiIcon.png" alt="Demo User">
                                </span>
                                <span class="wut-post-body">
                                    <span class="wut-post-head">
                                        <strong>Demo Operator</strong>
                                        <small>CAFE_DEV_02</small>
                                        <em>8 min. ago</em>
                                    </span>
                                    <span class="wut-post-community">
                                        <img src="res/olv/commu/MarioParty10.png" onerror="this.onerror=null;this.src='res/olv/default-image.png';" alt="">
                                        Mario Party Community
                                    </span>
                                    <span class="wut-post-copy">Trying the new community directory from the GamePad. The square artwork slots look great!</span>
                                    <span class="wut-post-meta">
                                        <b class="wut-yeah-control">Yeah!</b>
                                        <span>7 Yeahs</span>
                                        <span>3 Comments</span>
                                        <i>WII U</i>
                                    </span>
                                </span>
                            </a>
                        </li>

                        <li>
                            <a href="#feed-service-test" data-wut-focus-item="1" data-wut-demo-action="feed-post" data-wut-label="Service test post">
                                <span class="wut-post-user-icon">
                                    <img src="res/olv/mii/img_unknown_MiiIcon.png" alt="Demo User">
                                </span>
                                <span class="wut-post-body">
                                    <span class="wut-post-head">
                                        <strong>OLV Test Unit</strong>
                                        <small>LOCAL_NODE</small>
                                        <em>24 min. ago</em>
                                    </span>
                                    <span class="wut-post-community">
                                        <img src="res/olv/default-image.png" alt="">
                                        Cafe Test Community
                                    </span>
                                    <span class="wut-post-copy">Navigation response nominal. Post, reply and Yeah endpoints will connect here in a later milestone.</span>
                                    <span class="wut-post-meta">
                                        <b class="wut-yeah-control">Yeah!</b>
                                        <span>4 Yeahs</span>
                                        <span>0 Comments</span>
                                        <i>LOCAL</i>
                                    </span>
                                </span>
                            </a>
                        </li>
                    </ul>
                </div>

                <p id="wut-feed-status" class="wut-section-status">Choose a post to inspect the local preview.</p>
            </section>

            <section
                id="wut-user-page-view"
                class="wut-portal-panel none"
                aria-hidden="true"
            >
                <div class="wut-section-demo-strip">
                    <strong>CAFE OLV // USER PROFILE</strong>
                    <small>SESSION ADAPTER VIEW</small>
                    <span id="wut-profile-session-state"><b>LOCAL</b> MODE</span>
                </div>

                <div class="wut-profile-page">
                    <div class="wut-profile-card">
                        <span class="wut-profile-mii-frame">
                            <img id="wut-profile-mii" src="res/olv/mii/img_unknown_MiiIcon.png" onerror="this.onerror=null;this.src='res/olv/mii/img_unknown_MiiIcon.png';" alt="Current user Mii">
                        </span>
                        <div class="wut-profile-identity">
                            <h2 id="wut-profile-name">Cafe User</h2>
                            <p id="wut-profile-id">WUT_USER</p>
                            <span id="wut-profile-network">LOCAL SESSION</span>
                        </div>
                        <div class="wut-profile-skill">
                            <small>GAME EXPERIENCE</small>
                            <strong id="wut-profile-game-skill">Not set</strong>
                        </div>
                        <dl class="wut-profile-counts">
                            <dt>Posts</dt><dd>3</dd>
                            <dt>Yeahs</dt><dd>12</dd>
                            <dt>Following</dt><dd>4</dd>
                        </dl>
                    </div>

                    <ul id="wut-profile-tabs" class="wut-demo-tabs wut-profile-tabs">
                        <li class="selected"><a href="#profile-posts" data-wut-focus-item="1" data-wut-demo-action="profile-posts" data-wut-label="Posts tab">Posts</a></li>
                        <li><a href="#profile-yeahs" data-wut-focus-item="1" data-wut-demo-action="profile-yeahs" data-wut-label="Yeahs tab">Yeahs</a></li>
                        <li><a href="#profile-friends" data-wut-focus-item="1" data-wut-demo-action="profile-friends" data-wut-label="Friends tab">Friends</a></li>
                    </ul>

                    <div class="wut-profile-preview">
                        <a href="#profile-local-post" class="wut-profile-post" data-wut-focus-item="1" data-wut-demo-action="profile-post" data-wut-label="Local profile post">
                            <span class="wut-profile-post-badge">LATEST LOCAL POST</span>
                            <strong>Welcome to my User Page!</strong>
                            <span>This preview will use the authenticated WUT profile when identity resolution is connected.</span>
                            <small>Just now&nbsp;&nbsp; / &nbsp;&nbsp;2 Yeahs&nbsp;&nbsp; / &nbsp;&nbsp;1 Comment</small>
                        </a>
                    </div>
                </div>

                <p id="wut-profile-status" class="wut-section-status">Profile preview is using local session data.</p>
            </section>

            <section
                id="wut-communities-view"
                class="wut-portal-panel none"
                aria-hidden="true"
            >
                <div class="wut-plaza-lite">
                    <div class="wut-plaza-lite-title">
                        <strong>Communities</strong>
                    </div>

                    <div id="wut-community-scroll" class="wut-community-scroll">
                        <div id="wut-community-grid" class="wut-community-grid">
                            <div class="wut-community-entry">
                                <a href="#community-mario-kart" class="wut-community-card" data-community-index="0" data-community-title="Mario Kart Community">
                                    <span class="wut-community-icon"><img src="res/olv/commu/thumb/marioKart.png" onerror="this.onerror=null;this.src='res/olv/commu/thumb/default.png';" alt="Mario Kart Community"></span>
                                    <span class="wut-community-body"><strong>Mario Kart Community</strong><small>RACING SERIES / WII U SOFTWARE</small></span>
                                </a>
                            </div>

                            <div class="wut-community-entry">
                                <a href="#community-grace" class="wut-community-card" data-community-index="1" data-community-title="Grace Community">
                                    <span class="wut-community-icon"><img src="res/olv/commu/thumb/grace.png" onerror="this.onerror=null;this.src='res/olv/commu/thumb/default.png';" alt="Grace Community"></span>
                                    <span class="wut-community-body"><strong>Grace Community</strong><small>SOCIAL SIMULATION / SAMPLE GROUP</small></span>
                                </a>
                            </div>

                            <div class="wut-community-entry">
                                <a href="#community-mario-party" class="wut-community-card" data-community-index="2" data-community-title="Mario Party Community">
                                    <span class="wut-community-icon"><img src="res/olv/commu/thumb/MarioParty10.png" onerror="this.onerror=null;this.src='res/olv/commu/thumb/default.png';" alt="Mario Party Community"></span>
                                    <span class="wut-community-body"><strong>Mario Party Community</strong><small>PARTY SERIES / WII U SOFTWARE</small></span>
                                </a>
                            </div>

                            <div class="wut-community-entry">
                                <a href="#community-metroid" class="wut-community-card" data-community-index="3" data-community-title="Metroid Community">
                                    <span class="wut-community-icon"><img src="res/olv/commu/thumb/Metroid.png" onerror="this.onerror=null;this.src='res/olv/commu/thumb/default.png';" alt="Metroid Community"></span>
                                    <span class="wut-community-body"><strong>Metroid Community</strong><small>ACTION SERIES / SAMPLE GROUP</small></span>
                                </a>
                            </div>

                            <div class="wut-community-entry">
                                <a href="#community-yoshi" class="wut-community-card" data-community-index="4" data-community-title="Yoshi Community">
                                    <span class="wut-community-icon"><img src="res/olv/commu/thumb/YoshiWollyWorld.png" onerror="this.onerror=null;this.src='res/olv/commu/thumb/default.png';" alt="Yoshi Community"></span>
                                    <span class="wut-community-body"><strong>Yoshi Community</strong><small>PLATFORM SERIES / WII U SOFTWARE</small></span>
                                </a>
                            </div>

                            <div class="wut-community-entry">
                                <a href="#community-wii-fit" class="wut-community-card" data-community-index="5" data-community-title="Wii Fit Community">
                                    <span class="wut-community-icon"><img src="res/olv/commu/thumb/Wii_Fit_U.png" onerror="this.onerror=null;this.src='res/olv/commu/thumb/default.png';" alt="Wii Fit Community"></span>
                                    <span class="wut-community-body"><strong>Wii Fit Community</strong><small>HEALTH &amp; FITNESS / WII U SOFTWARE</small></span>
                                </a>
                            </div>

                            <div class="wut-community-entry">
                                <a href="#community-new-super-mario-bros-u" class="wut-community-card" data-community-index="6" data-community-title="New Super Mario Bros. U Community">
                                    <span class="wut-community-icon"><img src="res/olv/commu/thumb/NewSuperMarioBrosU.png" onerror="this.onerror=null;this.src='res/olv/commu/thumb/default.png';" alt="New Super Mario Bros. U Community"></span>
                                    <span class="wut-community-body"><strong>New Super Mario Bros. U Community</strong><small>PLATFORM GAME / WII U SOFTWARE</small></span>
                                </a>
                            </div>

                            <div class="wut-community-entry">
                                <a href="#community-shooter" class="wut-community-card" data-community-index="7" data-community-title="Shooter Community">
                                    <span class="wut-community-icon"><img src="res/olv/commu/thumb/shooter.png" onerror="this.onerror=null;this.src='res/olv/commu/thumb/default.png';" alt="Shooter Community"></span>
                                    <span class="wut-community-body"><strong>Shooter Community</strong><small>ACTION GAMES / SAMPLE GROUP</small></span>
                                </a>
                            </div>

                            <div class="wut-community-entry">
                                <a href="#community-zelda" class="wut-community-card" data-community-index="8" data-community-title="The Legend of Zelda Community">
                                    <span class="wut-community-icon"><img src="res/olv/commu/thumb/botw.png" onerror="this.onerror=null;this.src='res/olv/commu/thumb/default.png';" alt="The Legend of Zelda Community"></span>
                                    <span class="wut-community-body"><strong>The Legend of Zelda Community</strong><small>ADVENTURE SERIES / WII U SOFTWARE</small></span>
                                </a>
                            </div>

                            <div class="wut-community-entry">
                                <a href="#community-wut-announcements" class="wut-community-card" data-community-index="9" data-community-title="WUT Announcements">
                                    <span class="wut-community-icon"><img src="res/olv/commu/thumb/default.png" onerror="this.onerror=null;" alt="WUT Announcements"></span>
                                    <span class="wut-community-body"><strong>WUT Announcements</strong><small>SERVICE INFORMATION / LOCAL GROUP</small></span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section
                id="wut-messages-view"
                class="wut-portal-panel none"
                aria-hidden="true"
            >
                <div class="wut-section-demo-strip">
                    <strong>CAFE OLV // MESSAGE DIRECTORY</strong>
                    <small>CONVERSATION PREVIEW</small>
                    <span><b>03</b> THREADS</span>
                </div>

                <div class="wut-section-tip">
                    <img src="res/olv/tutorial/tutorial-message.png" alt="">
                    <p>Messages are exchanged with friends. This demo exposes the conversation list only; sending is not connected yet.</p>
                    <b>PREVIEW</b>
                </div>

                <div class="wut-section-scroll wut-message-scroll">
                    <ul id="wut-message-list" class="wut-directory-list">
                        <li class="wut-unread">
                            <a href="#message-demo-operator" data-wut-focus-item="1" data-wut-demo-action="message-thread" data-wut-label="Conversation with Demo Operator">
                                <span class="wut-directory-icon"><img src="res/olv/mii/img_unknown_MiiIcon.png" alt="Demo Operator"></span>
                                <span class="wut-directory-body">
                                    <strong>Demo Operator <small>CAFE_DEV_02</small></strong>
                                    <em>2 min. ago</em>
                                    <span>Did the community directory load correctly on the GamePad?</span>
                                </span>
                                <i class="wut-directory-arrow"></i>
                            </a>
                        </li>
                        <li>
                            <a href="#message-olv-test" data-wut-focus-item="1" data-wut-demo-action="message-thread" data-wut-label="Conversation with OLV Test Unit">
                                <span class="wut-directory-icon"><img src="res/olv/mii/img_unknown_MiiIcon.png" alt="OLV Test Unit"></span>
                                <span class="wut-directory-body">
                                    <strong>OLV Test Unit <small>LOCAL_NODE</small></strong>
                                    <em>Yesterday</em>
                                    <span>System check complete. The Portal shell remained active.</span>
                                </span>
                                <i class="wut-directory-arrow"></i>
                            </a>
                        </li>
                        <li>
                            <a href="#message-friend-slot" data-wut-focus-item="1" data-wut-demo-action="message-thread" data-wut-label="Empty friend message slot">
                                <span class="wut-directory-icon"><img src="res/olv/mii/img_unknown_MiiIcon.png" alt="Friend Slot"></span>
                                <span class="wut-directory-body">
                                    <strong>Friend Slot <small>WAITING_FOR_API</small></strong>
                                    <em>No messages</em>
                                    <span class="placeholder">You haven't exchanged messages with this user yet.</span>
                                </span>
                                <i class="wut-directory-arrow"></i>
                            </a>
                        </li>
                    </ul>
                </div>

                <p id="wut-message-status" class="wut-section-status">Choose a conversation preview.</p>
            </section>

            <section
                id="wut-notifications-view"
                class="wut-portal-panel none"
                aria-hidden="true"
            >
                <div class="wut-section-demo-strip">
                    <strong>CAFE OLV // NOTIFICATION CENTER</strong>
                    <small>EVENT PREVIEW BUFFER</small>
                    <span><b>04</b> EVENTS</span>
                </div>

                <ul id="wut-notification-tabs" class="wut-demo-tabs wut-notification-tabs">
                    <li class="selected"><a href="#notification-updates" data-wut-focus-item="1" data-wut-demo-action="notification-updates" data-wut-label="Updates tab">Updates</a></li>
                    <li><a href="#notification-requests" data-wut-focus-item="1" data-wut-demo-action="notification-requests" data-wut-label="Friend Requests tab">Friend Requests <b>1</b></a></li>
                </ul>

                <div class="wut-section-scroll wut-notification-scroll">
                    <ul id="wut-notification-updates" class="wut-directory-list wut-news-list">
                        <li>
                            <a href="#news-yeah" data-wut-focus-item="1" data-wut-demo-action="notification-item" data-wut-label="Yeah notification">
                                <span class="wut-directory-icon wut-news-icon wut-news-yeah"><img src="res/olv/feeling-happy.png" alt="Yeah"></span>
                                <span class="wut-directory-body">
                                    <strong>Demo Operator <small>CAFE_DEV_02</small></strong>
                                    <em>Just now</em>
                                    <span>gave a Yeah to your post in WUT Announcements.</span>
                                </span>
                                <i class="wut-directory-arrow"></i>
                            </a>
                        </li>
                        <li>
                            <a href="#news-comment" data-wut-focus-item="1" data-wut-demo-action="notification-item" data-wut-label="Comment notification">
                                <span class="wut-directory-icon wut-news-icon wut-news-comment">...</span>
                                <span class="wut-directory-body">
                                    <strong>OLV Test Unit <small>LOCAL_NODE</small></strong>
                                    <em>12 min. ago</em>
                                    <span>commented on your activity feed post.</span>
                                </span>
                                <i class="wut-directory-arrow"></i>
                            </a>
                        </li>
                        <li>
                            <a href="#news-follow" data-wut-focus-item="1" data-wut-demo-action="notification-item" data-wut-label="Follow notification">
                                <span class="wut-directory-icon"><img src="res/olv/mii/img_unknown_MiiIcon.png" alt="Cafe User"></span>
                                <span class="wut-directory-body">
                                    <strong>Cafe User 03 <small>DEV_GUEST</small></strong>
                                    <em>1 hour ago</em>
                                    <span>started following you.</span>
                                </span>
                                <i class="wut-directory-arrow"></i>
                            </a>
                        </li>
                    </ul>

                    <ul id="wut-notification-requests" class="wut-directory-list wut-news-list none" aria-hidden="true">
                        <li class="wut-unread">
                            <a href="#request-demo" data-wut-focus-item="1" data-wut-focus-disabled="1" data-wut-demo-action="friend-request" data-wut-label="Friend request from Cafe Guest">
                                <span class="wut-directory-icon"><img src="res/olv/mii/img_unknown_MiiIcon.png" alt="Cafe Guest"></span>
                                <span class="wut-directory-body">
                                    <strong>Cafe Guest <small>EARLY_TESTER</small></strong>
                                    <em>5 min. ago</em>
                                    <span>sent you a friend request. Acceptance requires the future relationship service.</span>
                                </span>
                                <i class="wut-directory-arrow"></i>
                            </a>
                        </li>
                    </ul>
                </div>

                <p id="wut-notification-status" class="wut-section-status">Updates preview selected.</p>
            </section>
        </div>
    </div>

    <a id="wut-beta-corner-action" href="#comment" data-wut-focus-disabled="1" aria-label="Comment">
        <span class="wut-beta-corner-glyph">+</span>
        <span class="wut-beta-corner-label">Comment</span>
    </a>
</div>

<script src="script/olv_store.js"></script>
<script src="script/olv_session.js"></script>
<script src="script/olv_identity.js"></script>
<script src="script/olv_mii.js"></script>
<script src="script/cafe_input.js"></script>
<script src="script/olv_communities.js?v=plaza-touch-2"></script>
<script src="script/olv_sections.js"></script>
<script src="script/olv_portal.js"></script>
<script src="script/olv_beta_menu_state.js"></script>
<script src="script/olv_beta_touch.js"></script>

</body>
</html>
